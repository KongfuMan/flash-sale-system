{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping the Spring Boot application",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "8.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "Flash Sale - Spring Boot",
  "description": "Micrometer metrics from a Prometheus-scraped Spring Boot application. Average latency uses timer sum/count; order list percentiles use histogram buckets.",
  "tags": ["spring-boot", "micrometer", "flashsale"],
  "timezone": "browser",
  "schemaVersion": 30,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "textbox",
        "query": "flashsale",
        "current": { "text": "flashsale", "value": "flashsale" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Availability",
      "description": "Percentage of currently discovered scrape targets that are up; no data means no matching targets.",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "avg(up{job=\"$job\"}) * 100", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 100 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" }
    },
    {
      "id": 2,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"$job\"}[$__rate_interval]))", "legendFormat": "Requests", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "HTTP 5xx Error Rate",
      "description": "Percentage of HTTP requests returning a 5xx status. No data when there is no request traffic.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"$job\",status=~\"5..\"}[$__rate_interval])) or sum(rate(http_server_requests_seconds_count{job=\"$job\"}[$__rate_interval])) * 0) / (sum(rate(http_server_requests_seconds_count{job=\"$job\"}[$__rate_interval])) > 0)", "legendFormat": "5xx", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Average HTTP Latency",
      "description": "Request-weighted mean across instances, computed from Micrometer timer sum and count. No histogram is required.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_sum{job=\"$job\"}[$__rate_interval])) / (sum(rate(http_server_requests_seconds_count{job=\"$job\"}[$__rate_interval])) > 0)", "legendFormat": "Average", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "JVM Heap",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"$job\",area=\"heap\"})", "legendFormat": "{{instance}} used", "refId": "A" },
        { "expr": "sum by (instance) (jvm_memory_committed_bytes{job=\"$job\",area=\"heap\"})", "legendFormat": "{{instance}} committed", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "CPU Usage",
      "description": "Process and system CPU usage as reported by Micrometer.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        { "expr": "process_cpu_usage{job=\"$job\"}", "legendFormat": "{{instance}} process", "refId": "A" },
        { "expr": "system_cpu_usage{job=\"$job\"}", "legendFormat": "{{instance}} system", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Database Connections (HikariCP)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"$job\"}", "legendFormat": "{{instance}} {{pool}} active", "refId": "A" },
        { "expr": "hikaricp_connections_idle{job=\"$job\"}", "legendFormat": "{{instance}} {{pool}} idle", "refId": "B" },
        { "expr": "hikaricp_connections_pending{job=\"$job\"}", "legendFormat": "{{instance}} {{pool}} pending", "refId": "C" },
        { "expr": "hikaricp_connections_max{job=\"$job\"}", "legendFormat": "{{instance}} {{pool}} max", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "HTTP Request Worker Threads (Tomcat)",
      "description": "Busy, current and maximum connector worker threads per application instance.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "targets": [
        { "expr": "tomcat_threads_busy_threads{job=\"$job\"}", "legendFormat": "{{instance}} busy", "refId": "A" },
        { "expr": "tomcat_threads_current_threads{job=\"$job\"}", "legendFormat": "{{instance}} current", "refId": "B" },
        { "expr": "tomcat_threads_config_max_threads{job=\"$job\"}", "legendFormat": "{{instance}} max", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "Order List Request Latency",
      "description": "Mean and approximate histogram percentiles use rates over $__rate_interval. Max is the highest sampled Micrometer rolling max over $__rate_interval, not an exact benchmark maximum; its rolling window may differ from the query window. Percentiles require histogram buckets.",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 38 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_sum{job=\"$job\",method=\"GET\",uri=\"/api/v1/orders\"}[$__rate_interval])) / (sum(rate(http_server_requests_seconds_count{job=\"$job\",method=\"GET\",uri=\"/api/v1/orders\"}[$__rate_interval])) > 0)", "legendFormat": "Mean", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"$job\",method=\"GET\",uri=\"/api/v1/orders\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"$job\",method=\"GET\",uri=\"/api/v1/orders\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C" },
        { "expr": "max(max_over_time(http_server_requests_seconds_max{job=\"$job\",method=\"GET\",uri=\"/api/v1/orders\"}[$__rate_interval]))", "legendFormat": "Max", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    }
  ]
}
